{
  "name": "schoolpilot-parent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3002",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3002",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "api:generate": "node scripts/generate-api.mjs",
    "check": "yarn typecheck && yarn lint && yarn test && yarn build",
    "format": "prettier --write src tests scripts/*.mjs *.ts *.mjs",
    "api:check": "node scripts/generate-api.mjs --check"
  },
  "dependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource/inter": "5.2.8",
    "@fontsource/noto-sans-arabic": "5.3.0",
    "@mui/material": "7.3.9",
    "@wandersonalwes/iconsax-react": "0.0.10",
    "next": "16.4.5",
    "openid-client": "6.8.9",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-intl": "10.0.0",
    "redis": "6.3.1",
    "server-only": "0.0.1",
    "stylis": "4.3.6",
    "stylis-plugin-rtl": "2.1.1",
    "swr": "2.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.65.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "25.5.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/stylis": "4.2.7",
    "eslint": "9.39.2",
    "eslint-config-next": "16.4.5",
    "jsdom": "29.0.0",
    "openapi-typescript": "7.13.0",
    "playwright-core": "1.65.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "vite": "8.0.3",
    "vitest": "5.1.0"
  },
  "packageManager": "yarn@4.13.0",
  "engines": {
    "node": ">=22.12.0 <27"
  }
}
