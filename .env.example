APP_ENV=development
ALLOW_LOCAL_HTTP=true
PORTAL_ORIGIN=http://localhost:3002
OIDC_ISSUER=http://auth.localhost:8080/realms/schoolos
OIDC_CLIENT_ID=schoolpilot-parent
CONTROL_API_URL=http://localhost:8083
SCHOOL_API_ORIGINS=http://localhost:8081,http://localhost:8082
SESSION_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
REDIS_URL=redis://:REPLACE_WITH_RANDOM_PASSWORD@localhost:56381

# Opt in only for trusted native local tenants on loopback ports 18000–18999.
ALLOW_PROVISIONED_LOCAL_SCHOOLS=false

# Public invitation destinations; HTTPS origins are required outside local development.
MANAGEMENT_PORTAL_ORIGIN=http://localhost:3000
TEACHER_PORTAL_ORIGIN=http://localhost:3001
PARENT_PORTAL_ORIGIN=http://localhost:3002
STUDENT_PORTAL_ORIGIN=http://localhost:3003
